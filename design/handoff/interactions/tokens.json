{
  "$schema-note": "모션 토큰. 시간은 ms, 거리는 pt/dp. curve는 cubic-bezier [x1, y1, x2, y2]. W는 화면 폭. default:true 는 디자인 결정이 아닌 구현 기본값. 설명은 motion.md.",
  "version": "2026-10-05",
  "source": "docs/design/decisions.md (2026-10-05 행), design/handoff/interactions/motion.md",
  "curves": {
    "standard": [0.32, 0.72, 0, 1],
    "spring-sheet": [0.2, 1.25, 0.4, 1],
    "accelerate": [0.4, 0, 1, 1],
    "emphasized": [0.2, 0, 0, 1],
    "fade-in": [0, 0, 0.2, 1],
    "throw": [0.5, 0, 0.9, 0.5],
    "ease": [0.25, 0.1, 0.25, 1],
    "ease-in": [0.42, 0, 1, 1],
    "ease-out": [0, 0, 0.58, 1]
  },
  "scrim": {
    "blur": 12,
    "dimLight": 0.24,
    "dimDark": 0.45,
    "in": { "duration": 400, "curve": "ease-out" },
    "out": { "duration": 260, "curve": "ease-in" }
  },
  "motions": {
    "sheet": {
      "open": { "property": "translateY", "from": "sheetHeight", "to": 0, "duration": 480, "curve": "spring-sheet", "overshootPadding": 80 },
      "close": { "property": "translateY", "from": 0, "to": "sheetHeight", "duration": 260, "curve": "accelerate" },
      "dragDismiss": { "distanceRatio": 0.25, "velocity": 1000, "snapBack": { "duration": 300, "curve": "spring-sheet" }, "default": true },
      "stepResize": { "duration": 300, "curve": "emphasized", "default": true }
    },
    "dialog": {
      "in": { "opacity": [0, 1], "scale": [0.96, 1], "duration": 200, "curve": "fade-in", "default": true },
      "out": { "opacity": [1, 0], "duration": 150, "curve": "ease-in", "default": true }
    },
    "pushPhoto": {
      "open": {
        "sharedPhoto": { "bounds": "card photo -> detail photo", "cornerRadius": 20, "duration": 420, "curve": "emphasized" },
        "content": { "opacity": [0, 1], "duration": 420, "curve": "ease-out" }
      },
      "back": {
        "sharedPhoto": { "bounds": "detail photo -> card photo", "duration": 360, "curve": "emphasized" },
        "content": { "opacity": [1, 0], "duration": 250, "curve": "ease-in" }
      }
    },
    "pushSurface": {
      "lift": { "outset": 3, "shadow": { "y": 8, "blur": 24, "alpha": 0.14 }, "duration": 80, "curve": "ease-out" },
      "expand": { "bounds": "lifted element -> full screen", "cornerRadius": ["element", 0], "color": ["element surface", "next screen background"], "duration": 420, "curve": "emphasized" },
      "content": { "opacity": [0, 1], "delay": 190, "duration": 230, "curve": "ease-out" },
      "back": {
        "content": { "opacity": [1, 0], "duration": 180, "curve": "ease-in" },
        "shrink": { "bounds": "full screen -> lifted element", "duration": 360, "curve": "emphasized" },
        "settle": { "bounds": "lifted element -> element", "duration": 80, "curve": "ease-in" }
      }
    },
    "interactiveBack": { "commitProgress": 0.5, "default": true },
    "tab": {
      "outgoing": { "opacity": [1, 0], "duration": 90, "curve": "ease-in" },
      "incoming": { "opacity": [0, 1], "scale": [0.97, 1], "delay": 90, "duration": 210, "curve": "fade-in" },
      "pill": { "property": "translateX", "duration": 250, "curve": "standard" },
      "labelSwapAt": 125
    },
    "reviewCard": {
      "throw": { "translateX": 480, "rotate": 16, "transformOrigin": [0.5, 0.9], "duration": 340, "curve": "throw", "direction": { "confirm": 1, "hold": -1 } },
      "next": { "scale": [0.94, 1], "translateY": [14, 0], "delay": 40, "duration": 300, "curve": "emphasized" },
      "drag": { "rotatePerWidth": 16, "commitDistanceRatio": 0.3, "commitVelocity": 800, "snapBack": { "duration": 250, "curve": "emphasized" }, "default": true },
      "stack": [{ "inset": [8, 2, -2, 2], "rotate": -2.5 }, { "inset": [14, 6, -6, 6], "rotate": 3 }]
    },
    "fillNext": {
      "current": { "translateX": [0, "-W"], "duration": 320, "curve": "standard" },
      "next": { "translateX": ["W", 0], "duration": 320, "curve": "standard" },
      "fixed": ["header", "bottomButtons"]
    },
    "shareCard": {
      "in": { "translateY": [140, 0], "duration": 340, "curve": "standard" },
      "hold": 1500,
      "out": { "translateY": [0, 140], "duration": 260, "curve": "accelerate" },
      "position": { "bottom": 40, "horizontal": 16 }
    },
    "disclosureArrow": { "rotate": [0, 180], "duration": 200, "curve": "ease" },
    "disclosureContent": { "duration": 200, "curve": "ease", "default": true },
    "editPanel": { "height": { "duration": 260, "curve": "ease" }, "opacity": { "duration": 200, "curve": "ease" }, "marginTop": [-16, 0] },
    "collapsedHeaderBar": { "opacity": [0, 1], "translateY": [-8, 0], "duration": 220, "curve": "ease" },
    "headerCollapse": { "barHeight": 108, "collapseSlack": 24, "snapLock": 450, "scroll": { "duration": 300, "curve": "emphasized", "default": true } },
    "overflowMenu": { "opacity": [0, 1], "scale": [0.96, 1], "duration": 150, "curve": "ease-out", "default": true },
    "purposeCardExpand": { "duration": 300, "curve": "emphasized", "default": true }
  }
}
