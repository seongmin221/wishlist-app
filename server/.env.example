POSTGRES_DB=wishlist
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
# Local API remains health-only until all four values below are supplied.
# APP_ENV=local
# APP_ROLE=api
# DATABASE_URL=jdbc:postgresql://localhost:5432/wishlist
# DATABASE_USER=wishlist
# DATABASE_PASSWORD=local-development-only
# FIREBASE_PROJECT_ID=wishlist-local
# Optional positive override. Defaults: API 5, general-worker 2.
# DB_POOL_MAX_SIZE=5
# Each pool keeps minimumIdle=0 and waits at most 5000ms for a connection.
# User images (B6). Production requires MEDIA_BUCKET (private GCS bucket); API and maintenance use it.
# MEDIA_BUCKET=
# Without MEDIA_BUCKET locally, the API stores images under MEDIA_LOCAL_DIR and serves signed
# /local/media-objects/** URLs built from MEDIA_LOCAL_BASE_URL (default http://localhost:${PORT:-8080}).
# A real phone or emulator cannot reach the host's localhost: set the host's LAN address
# (for example http://192.168.0.10:8080) or http://10.0.2.2:8080 for the Android emulator.
# MEDIA_LOCAL_DIR=build/local-media
# MEDIA_LOCAL_BASE_URL=http://192.168.0.10:8080
