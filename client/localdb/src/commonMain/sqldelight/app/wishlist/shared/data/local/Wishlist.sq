-- C2 minimal local schema (D7). No tokens are stored. Money and Instants are exact text.
CREATE TABLE local_submission (
    client_submission_id TEXT NOT NULL PRIMARY KEY,
    source_url TEXT NOT NULL,
    created_at TEXT NOT NULL,
    account_binding TEXT,
    status TEXT NOT NULL,
    server_item_id TEXT,
    error_kind TEXT,
    error_code TEXT,
    error_request_id TEXT,
    error_current_version INTEGER,
    error_retry_after_seconds INTEGER
);

CREATE TABLE item_cache (
    account_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    version INTEGER NOT NULL,
    client_submission_id TEXT NOT NULL,
    source_url TEXT NOT NULL,
    product_name TEXT,
    product_image_url TEXT,
    product_price TEXT,
    product_currency TEXT,
    product_brand TEXT,
    product_merchant TEXT,
    product_metadata_checked_at TEXT,
    product_name_source TEXT,
    product_image_source TEXT,
    category_id TEXT,
    category_source TEXT,
    category_missing_reason TEXT,
    category_name TEXT,
    category_parent_id TEXT,
    category_kind TEXT,
    purpose_id TEXT,
    purpose_source TEXT NOT NULL,
    analysis_status TEXT NOT NULL,
    analysis_failure_code TEXT,
    review_status TEXT NOT NULL,
    lifecycle_status TEXT NOT NULL,
    required_action TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    manual_completion_at TEXT,
    allowed_actions TEXT NOT NULL,
    client_created_at TEXT,
    PRIMARY KEY (account_id, item_id)
);

insertSubmission:
INSERT OR REPLACE INTO local_submission VALUES ?;

selectSubmission:
SELECT * FROM local_submission WHERE client_submission_id = ?;

selectVisibleSubmissions:
SELECT * FROM local_submission
WHERE account_binding IS NULL OR account_binding = :accountId
ORDER BY created_at, client_submission_id;

selectUnboundSubmissions:
SELECT * FROM local_submission WHERE account_binding IS NULL
ORDER BY created_at, client_submission_id;

deleteSubmission:
DELETE FROM local_submission WHERE client_submission_id = ?;

insertItem:
INSERT OR REPLACE INTO item_cache VALUES ?;

selectItem:
SELECT * FROM item_cache WHERE account_id = ? AND item_id = ?;

deleteItemThrough:
DELETE FROM item_cache WHERE account_id = ? AND item_id = ? AND version <= ?;

deleteAccountItems:
DELETE FROM item_cache WHERE account_id = ?;
