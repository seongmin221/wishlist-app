{
  "description": "Remind Codex to keep project documentation in sync with meaningful implementation changes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/remind_documentation.py\"",
            "timeout": 3,
            "statusMessage": "Checking documentation checkpoint"
          }
        ]
      }
    ]
  }
}
